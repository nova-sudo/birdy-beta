{
  "id": "dash_client_perf",
  "version": 2,
  "title": "Client performance",
  "widgets": [
    {
      "id": "w_title",
      "type": "heading",
      "version": 1,
      "title": "Client performance",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 1
      },
      "data": {
        "level": 1
      }
    },
    {
      "id": "w_kpi_spend",
      "type": "kpi",
      "version": 1,
      "title": "Spend (last 7 days)",
      "layout": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 3
      },
      "data": {
        "showDelta": true,
        "emphasis": "normal"
      },
      "bindings": {
        "value": {
          "metric": "spend",
          "window": {
            "preset": "last_7d"
          },
          "compare": "previous"
        }
      }
    },
    {
      "id": "w_kpi_strip",
      "type": "kpi-strip",
      "version": 1,
      "title": "Last 30 days",
      "layout": {
        "x": 3,
        "y": 1,
        "w": 9,
        "h": 3
      },
      "data": {
        "showDelta": true
      },
      "bindings": {
        "a": {
          "metric": "spend",
          "window": {
            "preset": "last_30d"
          },
          "compare": "previous"
        },
        "b": {
          "metric": "meta_leads",
          "window": {
            "preset": "last_30d"
          },
          "compare": "previous"
        },
        "c": {
          "metric": "clicks",
          "window": {
            "preset": "last_30d"
          },
          "compare": "previous"
        },
        "d": {
          "metric": "ctr",
          "window": {
            "preset": "last_30d"
          },
          "compare": "previous"
        }
      }
    },
    {
      "id": "w_trend_day",
      "type": "trend",
      "version": 1,
      "title": "Spend by day",
      "layout": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "data": {
        "chart": "line",
        "showPrevious": true
      },
      "bindings": {
        "series": {
          "metric": "spend",
          "by": "day",
          "window": {
            "preset": "last_30d"
          },
          "compare": "previous"
        }
      }
    },
    {
      "id": "w_trend_client",
      "type": "trend",
      "version": 1,
      "title": "Leads by client",
      "layout": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "data": {
        "chart": "bar",
        "showPrevious": false
      },
      "bindings": {
        "series": {
          "metric": "meta_leads",
          "by": "client",
          "window": {
            "preset": "last_30d"
          }
        }
      }
    },
    {
      "id": "w_bar",
      "type": "bar",
      "version": 1,
      "title": "Clicks by client",
      "layout": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "data": {
        "orientation": "horizontal",
        "sort": "none"
      },
      "bindings": {
        "series": {
          "metric": "clicks",
          "by": "client",
          "window": {
            "preset": "last_30d"
          }
        }
      }
    },
    {
      "id": "w_donut",
      "type": "donut",
      "version": 1,
      "title": "CTR by client",
      "layout": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "data": {
        "showLegend": true
      },
      "bindings": {
        "series": {
          "metric": "ctr",
          "by": "client",
          "window": {
            "preset": "last_30d"
          }
        }
      }
    },
    {
      "id": "w_compare",
      "type": "comparison",
      "version": 1,
      "title": "Spend vs leads",
      "layout": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "data": {
        "labelA": "Spend",
        "labelB": "Leads"
      },
      "bindings": {
        "a": {
          "metric": "spend",
          "by": "client",
          "window": {
            "preset": "last_30d"
          }
        },
        "b": {
          "metric": "meta_leads",
          "by": "client",
          "window": {
            "preset": "last_30d"
          }
        }
      }
    },
    {
      "id": "w_funnel",
      "type": "funnel",
      "version": 1,
      "title": "Funnel",
      "layout": {
        "x": 6,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "data": {
        "showConversion": true
      },
      "bindings": {
        "series": {
          "metric": "impressions",
          "window": {
            "preset": "last_30d"
          }
        }
      }
    },
    {
      "id": "w_leaders",
      "type": "leaderboard",
      "version": 1,
      "title": "Top clients",
      "layout": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "data": {
        "limit": 5,
        "showRank": true
      },
      "bindings": {
        "rows": {
          "metric": "spend",
          "by": "client",
          "window": {
            "preset": "last_30d"
          },
          "sort": "desc",
          "limit": 5
        }
      }
    },
    {
      "id": "w_table",
      "type": "table",
      "version": 1,
      "title": "Spend by client",
      "layout": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "data": {
        "columns": [
          "client",
          "spend"
        ],
        "dense": true
      },
      "bindings": {
        "rows": {
          "metric": "spend",
          "by": "client",
          "window": {
            "preset": "last_7d"
          }
        }
      }
    },
    {
      "id": "w_briefing",
      "type": "briefing",
      "version": 1,
      "title": "Briefing",
      "layout": {
        "x": 0,
        "y": 20,
        "w": 6,
        "h": 4
      },
      "data": {
        "parts": [
          {
            "text": "Static text"
          }
        ],
        "findings": [],
        "prompt": "lead quality"
      }
    },
    {
      "id": "w_note",
      "type": "text",
      "version": 1,
      "title": "Note",
      "layout": {
        "x": 6,
        "y": 20,
        "w": 6,
        "h": 3
      },
      "data": {
        "markdown": "Numbers refresh hourly."
      }
    }
  ],
  "meta": {
    "createdAt": "2026-10-18T00:00:00.000Z",
    "updatedAt": "2026-10-18T00:00:00.000Z",
    "lastAuthor": "user"
  }
}
